# systemd unit for stalbot — alternative to Docker (see README.md §7).
#
# Install:
#   sudo cp deploy/stalbot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now stalbot
#
# Before installing, edit the three paths/user below to match your host:
#   - User/Group:        a dedicated non-root system user, e.g.
#                         `sudo useradd --system --create-home stalbot`
#   - WorkingDirectory:  absolute path to this repository checkout
#   - ExecStart:         absolute path to the venv's python inside that checkout
#
# Logs: `journalctl -u stalbot -f`

[Unit]
Description=stalbot — Discord bot for Stalcraft (Stalzone)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stalbot
Group=stalbot
WorkingDirectory=/opt/stalbot
ExecStart=/opt/stalbot/.venv/bin/python -m stalbot
Restart=on-failure
RestartSec=5s

# .env is loaded by pydantic-settings from WorkingDirectory; EnvironmentFile
# is not required, but kept here in case host-level overrides are needed.
EnvironmentFile=-/opt/stalbot/.env

# Hardening — the bot only needs to read its own directory and write to
# data/ (SQLite cache, OCR samples) inside it. No credentials/ directory —
# there is no external API key to load.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/stalbot/data

# SEC-6: further restrict what a compromised/misbehaving process could do,
# on top of the above — none of this is a response to a known exploit path,
# just narrowing what's available. The bot is a plain asyncio network client
# (Discord gateway/HTTPS, local SQLite) with no need for kernel/namespace/
# capability access of any kind.
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
# Outbound-only network client (Discord gateway/HTTPS) —
# AF_UNIX covers local DNS-resolver/NSS paths some glibc resolvers use.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# `@system-service` is systemd's own broad allowlist for typical daemons —
# verify with `systemctl status stalbot` / `journalctl -u stalbot` after
# installing this unit, in case some dependency needs a syscall outside it.
# `SystemCallErrorNumber=EPERM` turns any such gap into a normal Python
# exception on that one call instead of `SIGSYS` killing the whole process.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
